---
---

<section class="w-full bg-white py-12 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 border border-black divide-x divide-y divide-black">
      <!-- 1: Infinity Loop -->
      <div class="h-28 flex items-center justify-center p-6 bg-white hover:bg-neutral-50 transition-colors">
        <svg class="w-16 h-10 text-black fill-current" viewBox="0 0 100 50">
          <path d="M30,10 C18,10 10,18 10,25 C10,32 18,40 30,40 C42,40 50,30 50,25 C50,20 58,10 70,10 C82,10 90,18 90,25 C90,32 82,40 70,40 C58,40 50,30 50,25 C50,20 42,10 30,10 Z M30,16 C38,16 43,22 45,25 C43,28 38,34 30,34 C21,34 16,29 16,25 C16,21 21,16 30,16 Z M70,16 C79,16 84,21 84,25 C84,29 79,34 70,34 C62,34 57,28 55,25 C57,22 62,16 70,16 Z"/>
        </svg>
      </div>

      <!-- 2: Fingerprint / Maze -->
      <div class="h-28 flex items-center justify-center p-6 bg-white hover:bg-neutral-50 transition-colors">
        <svg class="w-12 h-12 text-black" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round">
          <path d="M50 15 A 35 35 0 0 1 85 50 A 35 35 0 0 1 50 85 A 35 35 0 0 1 15 50 A 35 35 0 0 1 50 15" />
          <path d="M50 27 A 23 23 0 0 1 73 50 A 23 23 0 0 1 50 73 A 23 23 0 0 1 27 50 A 23 23 0 0 1 50 27" />
          <path d="M50 39 A 11 11 0 0 1 61 50 A 11 11 0 0 1 50 61 A 11 11 0 0 1 39 50 A 11 11 0 0 1 50 39" />
        </svg>
      </div>

      <!-- 3: Bold LOGO Box -->
      <div class="h-28 flex items-center justify-center p-6 bg-white hover:bg-neutral-50 transition-colors">
        <span class="text-2xl font-black tracking-widest text-black border-2 border-black px-3 py-1 font-display">
          LOGO
        </span>
      </div>

      <!-- 4: LOGOIPSUM with Triangle -->
      <div class="h-28 flex items-center justify-center p-6 bg-white hover:bg-neutral-50 transition-colors">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 fill-black" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <span class="font-extrabold tracking-wider text-black text-sm uppercase">LOGOIPSUM</span>
        </div>
      </div>

      <!-- 5: logoipsum with Triangle -->
      <div class="h-28 flex items-center justify-center p-6 bg-white hover:bg-neutral-50 transition-colors">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 fill-black" viewBox="0 0 24 24"><polygon points="6 4 18 12 6 20 6 4"/></svg>
          <span class="font-bold tracking-tight text-black text-sm lowercase">logoipsum</span>
        </div>
      </div>

      <!-- 6: logoipsum with Star -->
      <div class="h-28 flex items-center justify-center p-6 bg-white hover:bg-neutral-50 transition-colors">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-black" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="12" cy="12" r="3"/>
            <circle cx="12" cy="4" r="2"/>
            <circle cx="12" cy="20" r="2"/>
            <circle cx="4" cy="12" r="2"/>
            <circle cx="20" cy="12" r="2"/>
            <circle cx="6.5" cy="6.5" r="1.8"/>
            <circle cx="17.5" cy="17.5" r="1.8"/>
            <circle cx="6.5" cy="17.5" r="1.8"/>
            <circle cx="17.5" cy="6.5" r="1.8"/>
          </svg>
          <span class="font-bold tracking-tight text-black text-sm lowercase">logoipsum*</span>
        </div>
      </div>

      <!-- 7: Infinity Loop -->
      <div class="h-28 flex items-center justify-center p-6 bg-white hover:bg-neutral-50 transition-colors">
        <svg class="w-16 h-10 text-black fill-current" viewBox="0 0 100 50">
          <path d="M30,10 C18,10 10,18 10,25 C10,32 18,40 30,40 C42,40 50,30 50,25 C50,20 58,10 70,10 C82,10 90,18 90,25 C90,32 82,40 70,40 C58,40 50,30 50,25 C50,20 42,10 30,10 Z M30,16 C38,16 43,22 45,25 C43,28 38,34 30,34 C21,34 16,29 16,25 C16,21 21,16 30,16 Z M70,16 C79,16 84,21 84,25 C84,29 79,34 70,34 C62,34 57,28 55,25 C57,22 62,16 70,16 Z"/>
        </svg>
      </div>

      <!-- 8: Fingerprint / Maze -->
      <div class="h-28 flex items-center justify-center p-6 bg-white hover:bg-neutral-50 transition-colors">
        <svg class="w-12 h-12 text-black" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round">
          <path d="M50 15 A 35 35 0 0 1 85 50 A 35 35 0 0 1 50 85 A 35 35 0 0 1 15 50 A 35 35 0 0 1 50 15" />
          <path d="M50 27 A 23 23 0 0 1 73 50 A 23 23 0 0 1 50 73 A 23 23 0 0 1 27 50 A 23 23 0 0 1 50 27" />
          <path d="M50 39 A 11 11 0 0 1 61 50 A 11 11 0 0 1 50 61 A 11 11 0 0 1 39 50 A 11 11 0 0 1 50 39" />
        </svg>
      </div>
    </div>
  </div>
</section>