---
const plans = [
  {
    name: 'Personal',
    price: '$180',
    period: '/mo',
    desc: 'We care about their success. For us real relationships feel real',
    features: [
      'WEB & MOBILE',
      'FREE CUSTOM DOMAIN',
      'BEST HOSTING EVER',
      'OUTSTANDING SUPPORT',
      'WEB DESIGN'
    ]
  },
  {
    name: 'Startup',
    price: '$180',
    period: '/mo',
    desc: 'We care about their success. For us real relationships feel real',
    features: [
      'WEB & MOBILE',
      'FREE CUSTOM DOMAIN',
      'BEST HOSTING EVER',
      'OUTSTANDING SUPPORT',
      'WEB DESIGN'
    ]
  },
  {
    name: 'Corporate',
    price: '$180',
    period: '/mo',
    desc: 'We care about their success. For us real relationships feel real',
    features: [
      'WEB & MOBILE',
      'FREE CUSTOM DOMAIN',
      'BEST HOSTING EVER',
      'OUTSTANDING SUPPORT',
      'WEB DESIGN'
    ]
  }
];
---

<section id="pricing" class="w-full bg-white py-20 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {plans.map((plan) => (
        <div class="bg-[#f4f4f4] p-8 sm:p-10 flex flex-col justify-between hover:shadow-lg transition-shadow">
          <div>
            <h3 class="text-xl sm:text-2xl font-bold text-black font-display tracking-tight">
              {plan.name}
            </h3>

            <div class="mt-6 flex items-baseline gap-1">
              <span class="text-4xl sm:text-5xl font-black text-black font-display">
                {plan.price}
              </span>
              <span class="text-sm font-semibold text-neutral-600">
                {plan.period}
              </span>
            </div>

            <p class="mt-6 text-xs sm:text-sm text-neutral-600 leading-relaxed">
              {plan.desc}
            </p>

            <ul class="mt-8 space-y-3.5">
              {plan.features.map((feat) => (
                <li class="flex items-center gap-2.5 text-xs font-bold tracking-wider text-black">
                  <span class="text-black font-black">✓</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-10 pt-6">
            <button class="w-full bg-black hover:bg-neutral-800 text-white font-bold text-xs tracking-widest uppercase py-4 transition-colors">
              CHOOSE THIS PLAN
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>