---
const projects = [
  {
    title: 'Money Laundering Compliance Scanner',
    category: 'Branding / Development / Marketing',
    image: '/images/project-rock-spheres.jpg'
  },
  {
    title: 'Enhancing Workplace Safety Protocols',
    category: 'Branding / Development / Marketing',
    image: '/images/project-yellow-robot.jpg'
  },
  {
    title: 'Optimizing Supply Chain Efficiency',
    category: 'Branding / Development / Marketing',
    image: '/images/project-dark-mesh-sphere.jpg'
  },
  {
    title: 'Streamlining Financial Reporting',
    category: 'Branding / Development / Marketing',
    image: '/images/project-amber-ribbon.jpg'
  }
];
---

<section id="projects" class="w-full bg-white py-16 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-16">
      {projects.map((proj) => (
        <article class="group cursor-pointer">
          <div class="w-full aspect-[4/3] bg-neutral-100 overflow-hidden mb-6">
            <img 
              src={proj.image} 
              alt={proj.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
            />
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold text-black font-display tracking-tight leading-snug group-hover:text-neutral-700 transition-colors">
            {proj.title}
          </h3>
          <p class="mt-2 text-xs sm:text-sm text-neutral-500 font-medium">
            {proj.category}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>