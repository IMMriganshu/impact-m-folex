---
---

<header class="w-full bg-black border-b border-neutral-900 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#" class="text-2xl font-black tracking-tight text-white font-display">
      Folex
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-10 text-xs font-semibold tracking-widest text-neutral-300">
      <a href="#home" class="text-white hover:text-white transition-colors">HOME</a>
      <a href="#services" class="hover:text-white transition-colors">SERVICES</a>
      <a href="#projects" class="hover:text-white transition-colors">PROJECTS</a>
      <a href="#pricing" class="hover:text-white transition-colors">PRICING</a>
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-4">
      <!-- Language -->
      <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-neutral-800 text-xs font-medium text-white hover:border-neutral-600 transition-colors">
        <span>文A</span>
        <span>EN</span>
        <svg class="w-3 h-3 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>

      <!-- Get Started Button -->
      <a href="#contact" class="hidden sm:inline-flex items-center justify-center bg-[#ccff00] hover:bg-[#b8e600] text-black font-bold text-xs tracking-wider px-5 py-2.5 rounded-sm transition-colors">
        GET STARTED
      </a>

      <!-- Menu Icon Button -->
      <button class="w-9 h-9 rounded-full border border-neutral-800 flex flex-col items-center justify-center gap-1.5 hover:border-neutral-600 transition-colors" aria-label="Menu">
        <span class="w-4 h-0.5 bg-white"></span>
        <span class="w-4 h-0.5 bg-white"></span>
      </button>
    </div>
  </div>
</header>