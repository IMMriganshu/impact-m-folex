---
---

<section id="contact" class="w-full bg-[#ccff00] text-black py-20 px-6">
  <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
    <!-- Left Column: Headline & Social Links -->
    <div class="lg:col-span-5 flex flex-col justify-between">
      <div>
        <h2 class="text-5xl sm:text-6xl font-black tracking-tight font-display leading-[1.05]">
          Let’s Work<br />Together
        </h2>
        <p class="mt-6 text-sm sm:text-base font-medium text-black/80 leading-relaxed max-w-sm">
          We are digital agency that helps businesses develop immersive and engaging user experiences
        </p>
      </div>

      <div class="mt-12 lg:mt-24 space-y-6">
        <p class="text-xs font-medium text-black/70">
          Copyright © 2025 by your company / Crafted with Getastrothemes
        </p>
        <!-- Social Icons -->
        <div class="flex items-center gap-4 text-black text-lg">
          <a href="#" class="hover:opacity-75" aria-label="Facebook">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.57 5H18V0h-3.808C10.592 0 9 1.583 9 4.615V8z"/></svg>
          </a>
          <a href="#" class="hover:opacity-75" aria-label="X (Twitter)">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" class="hover:opacity-75" aria-label="Instagram">
            <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="#" class="hover:opacity-75" aria-label="LinkedIn">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Interactive Form -->
    <div class="lg:col-span-7">
      <form class="space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider mb-2">Full Name *</label>
            <input 
              type="text" 
              required 
              class="w-full bg-transparent border-b border-black pb-2 text-sm focus:outline-none placeholder:text-black/40"
              placeholder="John Doe"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider mb-2">Email Address *</label>
            <input 
              type="email" 
              required 
              class="w-full bg-transparent border-b border-black pb-2 text-sm focus:outline-none placeholder:text-black/40"
              placeholder="john@example.com"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider mb-2">Subject *</label>
            <select class="w-full bg-transparent border-b border-black pb-2 text-sm focus:outline-none appearance-none cursor-pointer">
              <option value="">Select subject</option>
              <option value="branding">Branding Design</option>
              <option value="development">Web Development</option>
              <option value="marketing">Digital Marketing</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider mb-2">Subject With Search *</label>
            <select class="w-full bg-transparent border-b border-black pb-2 text-sm focus:outline-none appearance-none cursor-pointer">
              <option value="">Select or search...</option>
              <option value="strategy">Product Strategy</option>
              <option value="fullstack">Fullstack Application</option>
              <option value="consulting">Growth Consulting</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-2">How can we help you *</label>
          <textarea 
            rows="3" 
            required 
            class="w-full bg-transparent border-b border-black pb-2 text-sm focus:outline-none resize-none placeholder:text-black/40"
            placeholder="Tell us about your project goals, timeline, and requirements..."
          ></textarea>
        </div>

        <div class="pt-2">
          <p class="text-xs font-semibold uppercase tracking-wider mb-3">How did you hear about us?</p>
          <div class="flex items-center gap-6">
            <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold">
              <input type="radio" name="source" value="google" checked class="accent-black" />
              <span>Google Search</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold">
              <input type="radio" name="source" value="social" class="accent-black" />
              <span>Social Media</span>
            </label>
          </div>
        </div>

        <div class="pt-2">
          <label class="flex items-start gap-2.5 cursor-pointer text-xs font-medium">
            <input type="checkbox" required class="mt-0.5 accent-black" />
            <span>I agree to the terms and conditions and <a href="#" class="underline font-semibold">privacy policy</a>.</span>
          </label>
        </div>

        <div class="pt-4">
          <button 
            type="submit" 
            class="bg-black text-white hover:bg-neutral-800 text-xs font-bold tracking-widest uppercase px-8 py-4 transition-colors"
          >
            SEND MESSAGE
          </button>
        </div>
      </form>
    </div>
  </div>
</section>