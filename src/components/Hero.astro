<section id="home" class="w-full bg-black pt-16 pb-20 px-6">
  <div class="max-w-6xl mx-auto flex flex-col items-center text-center">
    <!-- Headline -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight text-white font-display leading-[1.05] max-w-5xl">
      We Help to Grow<br />Your Business
    </h1>

    <!-- Subtitle -->
    <p class="mt-8 text-neutral-400 text-sm sm:text-base md:text-lg max-w-xl font-normal leading-relaxed">
      We are digital agency that helps businesses develop immersive and engaging user experiences that drive top level growth
    </p>

    <!-- Hero Image Container -->
    <div class="mt-14 w-full max-w-4xl rounded-2xl overflow-hidden shadow-2xl bg-neutral-900 border border-neutral-800/80 aspect-[16/10]">
      <img 
        src="/images/hero-workspace.jpg" 
        alt="Creative professional working at studio desk" 
        class="w-full h-full object-cover"
        loading="eager"
      />
    </div>
  </div>
</section>